{
  "name": "@taskflow/agent-runner",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded local implementation runner for TaskFlow: host-enforced turn, cost and tool limits around an Agent SDK run in an isolated git worktree.",
  "type": "module",
  "bin": {
    "taskflow-agent": "./dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.227"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "typescript": "7.0.2"
  }
}
