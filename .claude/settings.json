{
  "permissions": {
    "deny": [
      "Edit(**/.env)",
      "Write(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/.env.*)",
      "Edit(**/appsettings.Production.json)",
      "Write(**/appsettings.Production.json)",
      "Edit(**/*.pfx)",
      "Write(**/*.pfx)",
      "Edit(**/*.publishsettings)",
      "Write(**/*.publishsettings)",
      "Edit(**/*.pubxml)",
      "Write(**/*.pubxml)",
      "Edit(**/PublishScripts/**)",
      "Write(**/PublishScripts/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PROJECT_DIR}/.claude/hooks/format-edited-file.ps1\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "csharp-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true
  }
}
