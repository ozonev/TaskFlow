{
  "enabledPlugins": {
    "csharp-lsp@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File .claude/hooks/format-edited-file.ps1"
          }
        ]
      }
    ]
  }
}
